# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# .env.local est gitignored — ne jamais committer de vraies clés.

# ── Clerk (authentification + Organizations) ──
# Dashboard Clerk → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dashboard Clerk → Webhooks → endpoint /api/webhooks/clerk → Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# URLs de redirection Clerk (composants <SignIn>/<SignUp> hébergés par l'app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/create-organization

# ── Supabase (base de données) ──
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : bypass RLS total, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (abonnements) ──
# Dashboard Stripe → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Dashboard Stripe → Product catalog → Price IDs des 3 offres
STRIPE_PRICE_DECOUVERTE=
STRIPE_PRICE_CREATION=
STRIPE_PRICE_ENTREPRISE=

# Signing secret du webhook Stripe.
# ATTENTION : différent entre local (`stripe listen`) et production
# (endpoint créé dans Dashboard Stripe → Webhooks). Ne jamais copier l'un vers l'autre.
STRIPE_WEBHOOK_SECRET=

# ── IA (génération de formation par le Super-admin, V1) ──
# Clé fournie par l'encadrant Ahead. Ne jamais committer la vraie valeur.
OPENAI_API_KEY=
# Identifiant exact du modèle à utiliser. Confirmé via GET /v1/models : gpt-5.6-luna
# (variante "petite" recommandée pour les tests — gpt-5.6-sol / gpt-5.6-terra existent aussi).
OPENAI_MODEL=gpt-5.6-luna

# ── RAG (pipeline V2 : embeddings pour la recherche vectorielle) ──
# Clé fournie par l'encadrant Ahead. Ne jamais committer la vraie valeur.
VOYAGE_API_KEY=
# Modèle choisi dans le cahier des charges — dimension 1024, cf. colonne
# chunks.embedding (vector(1024), supabase/migrations/20260812000000_*.sql).
VOYAGE_MODEL=voyage-3

# ── Vidéo d'accompagnement de formation (YouTube Data API v3) ──
# Créée dans Google Cloud Console, restreinte à "YouTube Data API v3" uniquement.
# Utilisée côté serveur seulement (jamais exposée au navigateur, pas de préfixe
# NEXT_PUBLIC_).
YOUTUBE_API_KEY=

# ── App ──
# URL publique de l'app — utilisée pour les redirections Stripe Checkout
# success/cancel, ET pour le redirectUrl des invitations Clerk (apprenants) afin
# qu'elles reviennent dans l'app plutôt que sur les pages hébergées par défaut de
# Clerk (voir app/api/org/apprenants/invite/route.ts).
# En local : http://localhost:3000 — en prod : l'URL de déploiement réelle.
NEXT_PUBLIC_APP_URL=http://localhost:3000
